@page "/Account/Admin/SeoFiles"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = AdminAccessPolicy.Name)]
@rendermode InteractiveServer
@inject SeoSettingsStore SeoSettingsStore

<PageTitle>SEO Files Configuration</PageTitle>

<div class="flex flex-col gap-6 py-8">
    <PageHeader Title="SEO" Highlight="Files">
        <ChildContent>
            Configure sitemap.xml and robots.txt for the public site.
        </ChildContent>
    </PageHeader>

    @if (HasSuccessMessage)
    {
        <div class="@SuccessMessageClass">
            Settings saved successfully.
        </div>
    }

    <EditForm Model="FormInput" OnValidSubmit="OnValidSubmitAsync" FormName="seo-files-form" method="post">
        <DataAnnotationsValidator/>

        <ValidationSummary class="@ValidationSummaryClass" role="alert"/>

        <div class="mt-4 flex max-w-xl flex-col gap-4">
            <div class="flex flex-col gap-2">
                <label for="baseUrl" class="text-sm font-black tracking-widest uppercase">Base URL</label>

                <InputText id="baseUrl" @bind-Value="FormInput.BaseUrl"
                           class="@InputClass"
                           placeholder="https://example.com"/>

                <p class="text-sm font-bold text-neutral-600 dark:text-neutral-400">
                    Required unless <code>Security:CanonicalBaseUrl</code> is configured in the application settings.
                </p>
            </div>

            <div class="flex items-center gap-2">
                <InputCheckbox id="enableSitemap" @bind-Value="FormInput.EnableSitemap"
                               class="@CheckboxClass"/>

                <label for="enableSitemap" class="text-sm font-black tracking-widest uppercase">Enable
                    sitemap.xml</label>
            </div>

            <div class="flex items-center gap-2">
                <InputCheckbox id="enableRobots" @bind-Value="FormInput.EnableRobots"
                               class="@CheckboxClass"/>

                <label for="enableRobots" class="text-sm font-black tracking-widest uppercase">Enable robots.txt</label>
            </div>

            <div class="flex flex-col gap-2">
                <label for="robotsDisallow" class="text-sm font-black tracking-widest uppercase">Robots Disallow (one
                    per line)</label>

                <InputTextArea id="robotsDisallow" @bind-Value="FormInput.RobotsDisallow"
                               class="@InputClass"
                               rows="5" placeholder="/Account"/>
            </div>

            <button type="submit" class="@PrimaryButtonClass">
                Save
            </button>
        </div>
    </EditForm>
</div>

@code {
    private const string InputClass = "neo-input";
    private const string CheckboxClass = "h-5 w-5 border-2 border-black bg-white accent-black dark:border-white dark:bg-black dark:accent-white";
    private const string ValidationSummaryClass = "text-sm font-bold text-red-600 dark:text-red-400";
    private const string SuccessMessageClass = "neo-card mb-4 bg-green-400 px-4 py-3 font-bold text-black";
    private const string PrimaryButtonClass = "neo-button w-full text-center";

    private bool HasSuccessMessage { get; set; }

    [SupplyParameterFromForm] private InputModel FormInput { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        FormInput ??= new InputModel();
        await LoadFormInputAsync();
    }

    private async Task OnValidSubmitAsync()
    {
        await SaveSeoSettingsAsync();
        HasSuccessMessage = true;
    }

    private async Task LoadFormInputAsync()
    {
        var settings = await SeoSettingsStore.GetAsync();
        FormInput = CreateInputModel(settings);
    }

    private static InputModel CreateInputModel(SeoSettings settings)
    {
        return new InputModel
        {
            BaseUrl = settings.BaseUrl,
            EnableSitemap = settings.EnableSitemap,
            EnableRobots = settings.EnableRobots,
            RobotsDisallow = settings.RobotsDisallow
        };
    }

    private async Task SaveSeoSettingsAsync()
    {
        await SeoSettingsStore.SaveAsync(CreateSettingsFromForm());
    }

    private SeoSettings CreateSettingsFromForm()
    {
        return new SeoSettings
        {
            BaseUrl = FormInput.BaseUrl ?? string.Empty,
            EnableSitemap = FormInput.EnableSitemap,
            EnableRobots = FormInput.EnableRobots,
            RobotsDisallow = FormInput.RobotsDisallow ?? string.Empty
        };
    }

    private sealed class InputModel
    {
        public string? BaseUrl { get; set; }
        public bool EnableSitemap { get; set; } = true;
        public bool EnableRobots { get; set; } = true;
        public string? RobotsDisallow { get; set; } = SeoSettings.DefaultRobotsDisallowValue;
    }

}