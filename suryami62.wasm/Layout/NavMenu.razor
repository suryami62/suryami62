<header class="w-full border-b-4 border-black bg-white p-4 dark:border-white dark:bg-black">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 md:flex-row">
        <div
            class="-rotate-2 transform border-2 border-black bg-black px-3 py-1 text-2xl font-black tracking-tighter text-white uppercase shadow-[4px_4px_0px_0px_#000] select-none dark:border-white dark:bg-white dark:text-black dark:shadow-[4px_4px_0px_0px_#fff]">
            <Brand/>
        </div>

        <nav class="flex flex-wrap justify-center gap-4">
            @foreach (var link in Links)
            {
                <NavButton Href="@link.Href" Text="@link.Text"/>
            }
        </nav>
    </div>

</header>

@code {

    private class NavItem
    {
        public string Href { get; }
        public string Text { get; }

        public NavItem(string href, string text)
        {
            Href = href;
            Text = text;
        }
    }

    private List<NavItem> Links { get; } = new()
    {
        new NavItem("", "home"),
        new NavItem("projects", "projects"),
        new NavItem("about", "about")
    };

}
