<div
    class="border-2 border-black bg-white shadow-[4px_4px_0px_0px_#000] dark:border-white dark:bg-black dark:shadow-[4px_4px_0px_0px_#fff] p-6">
    <div class="mb-4 flex items-center gap-4">
        @if (HasIcon())
        {
            <i class="@IconClass text-4xl"></i>
        }
        <h2 class="text-3xl font-black uppercase">@Title</h2>
    </div>

    <div class="text-lg leading-relaxed font-medium">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string? IconClass { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool HasIcon()
    {
        return !string.IsNullOrEmpty(IconClass);
    }

}