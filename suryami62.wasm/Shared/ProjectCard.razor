<article
    class="flex h-full flex-col border-4 border-black bg-white p-6 shadow-[8px_8px_0px_0px_#000] dark:border-white dark:bg-black dark:shadow-[8px_8px_0px_0px_#fff]">
    <div class="mb-6 overflow-hidden border-4 border-black bg-gray-100 dark:border-white">
        <img src="@ImageUrl"
             alt="@Title"
             class="aspect-video w-full object-cover"/>
    </div>

    <p class="mb-8 font-medium text-gray-700 dark:text-gray-300">@Description</p>

    <div class="mt-auto flex gap-4">
        @if (HasRepoUrl())
        {
            <a href="@RepoUrl"
               target="_blank"
               rel="noopener noreferrer"
               class="block flex-1 translate-x-0 translate-y-0 border-2 border-white bg-black px-4 py-3 text-center font-bold text-white uppercase shadow-[4px_4px_0px_0px_#888] transition-all hover:bg-neutral-800 focus-visible:ring-2 focus-visible:ring-black focus-visible:ring-offset-2 focus-visible:outline-none active:translate-x-1 active:translate-y-1 active:shadow-none dark:border-black dark:bg-white dark:text-black dark:shadow-[4px_4px_0px_0px_#444] dark:hover:bg-neutral-200 dark:focus-visible:ring-white dark:focus-visible:ring-offset-black">
                View Code
            </a>
        }

        @if (HasDemoUrl())
        {
            <a href="@PreviewUrl"
               target="_blank"
               rel="noopener noreferrer"
               class="block flex-1 translate-x-0 translate-y-0 border-2 border-black bg-white px-4 py-3 text-center font-bold text-black uppercase shadow-[4px_4px_0px_0px_#000] transition-all hover:bg-neutral-300 focus-visible:ring-2 focus-visible:ring-black focus-visible:ring-offset-2 focus-visible:outline-none active:translate-x-1 active:translate-y-1 active:shadow-none dark:border-white dark:bg-black dark:text-white dark:shadow-[4px_4px_0px_0px_#fff] dark:hover:bg-neutral-700 dark:focus-visible:ring-white dark:focus-visible:ring-offset-black">
                Preview
            </a>
        }
    </div>
</article>

@code {
    [Parameter] public string? Title { get; set; }

    [Parameter] public string? Description { get; set; }

    [Parameter] public string? RepoUrl { get; set; }

    [Parameter] public string? PreviewUrl { get; set; }

    [Parameter] public string? ImageUrl { get; set; }

    private bool HasRepoUrl()
    {
        return !string.IsNullOrEmpty(RepoUrl);
    }

    private bool HasDemoUrl()
    {
        return !string.IsNullOrEmpty(PreviewUrl);
    }

}
