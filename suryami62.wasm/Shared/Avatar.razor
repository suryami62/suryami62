<div class="relative mx-auto w-full max-w-70 md:mx-0 md:max-w-[320px]">
    <img src="@AvatarUrl"
         alt="@Alt"
         class="border-4 border-black shadow-[8px_8px_0px_0px_#000] dark:border-white dark:shadow-[8px_8px_0px_0px_#fff] aspect-square w-full object-cover"/>
</div>

@code {
    [Parameter] public string? AvatarUrl { get; set; }

    [Parameter] public string? Alt { get; set; }
}
